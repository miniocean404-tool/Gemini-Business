# Clash 配置模板
# 请将你的订阅配置复制到此文件，并重命名为 local.yaml

mixed-port: 17890
allow-lan: true
mode: Global
log-level: info
external-controller: '127.0.0.1:9090'

proxies:
  # 在这里添加你的代理节点
  # 示例:
  # - { name: '节点名称', type: trojan, server: your.server.com, port: 443, password: your-password }

proxy-groups:
  - name: 代理组名称
    type: select
    proxies:
      # 添加你的节点名称

# 要更换 rule 匹配的组, MATCH 什么都没匹配到时执行
rules:
  - MATCH, ♻️ 自动选择
